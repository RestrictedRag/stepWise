# Copy to .env.local and fill in.

# Google Gemini Flash reads photos into text.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Gnani Evon v3.3 solves, via any OpenAI-compatible server.
# vLLM/SGLang: http://localhost:8000/v1  |  Ollama: http://localhost:11434/v1  |  LM Studio: http://localhost:1234/v1
EVON_BASE_URL=http://localhost:8000/v1
# Use the name your server lists (e.g. the Ollama tag you pulled).
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B
EVON_API_KEY=

# Optional: until Evon is hosted, set LLM_PROVIDER=gemini or groq to solve via that hosted API instead.
LLM_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
